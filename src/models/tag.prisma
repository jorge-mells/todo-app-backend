model Tag {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  todos TagsOnTodos[]

  @@map("tags")
}

model TagsOnTodos {
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  todoId    Int
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     Int

  @@id([todoId, tagId])
  @@map("tags_on_todos")
}
